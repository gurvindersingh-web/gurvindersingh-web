<svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve" width="820" height="372" viewBox="0 0 820 372" role="img" aria-label="whoami: Gurvinder Singh, Full-Stack Developer &amp; Automation Engineer, studying Computer Science at LPU" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="bar" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#d9826b"/>
      <stop offset="0.35" stop-color="#e5b567"/>
      <stop offset="0.65" stop-color="#9fc490"/>
      <stop offset="1" stop-color="#7eaecb"/>
    </linearGradient>
    <linearGradient id="motto" gradientUnits="userSpaceOnUse" x1="150" y1="0" x2="640" y2="0">
      <stop offset="0" stop-color="#d9826b"/>
      <stop offset="0.5" stop-color="#e5b567"/>
      <stop offset="1" stop-color="#b79ad0"/>
    </linearGradient>
  </defs>
  <style>
    text { font-family: 'JetBrains Mono','Fira Code','SF Mono',Consolas,'DejaVu Sans Mono',monospace; font-size: 15px; white-space: pre; }
    .l { animation: in .45s ease-out backwards; }
    @keyframes in { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }
    .cur { animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { fill: transparent; } }
    .user { fill: #9fc490; } .host { fill: #e5b567; } .path { fill: #7eaecb; }
    .t { fill: #d4cebd; } .cmd { fill: #f2efe6; }
    .br { fill: #8a8577; } .k { fill: #e5b567; } .s { fill: #9fc490; }
    .a { fill: #d9826b; } .b { fill: #7eaecb; } .c { fill: #b79ad0; } .d { fill: #6fc2b0; }
    @media (prefers-reduced-motion: reduce) { .l { animation: none; } .cur { animation: none; } }
  </style>

  <!-- window -->
  <rect x="0.5" y="0.5" width="819" height="371" rx="12" fill="#121212" stroke="#2e2c27"/>
  <path d="M1 12 Q1 1 12 1 H808 Q819 1 819 12 V36 H1 Z" fill="#1e1e1e"/>
  <rect x="1" y="35" width="818" height="2" fill="url(#bar)"/>
  <circle cx="24" cy="18" r="6" fill="#d9826b"/>
  <circle cx="44" cy="18" r="6" fill="#e5b567"/>
  <circle cx="64" cy="18" r="6" fill="#9fc490"/>
  <text x="410" y="23" text-anchor="middle" style="font-size:13px" fill="#8a8577">apkx@arch: ~</text>

  <!-- content -->
  <g class="l" style="animation-delay:.2s"><text x="28" y="72"><tspan class="user">apkx</tspan><tspan class="br">@</tspan><tspan class="host">arch</tspan><tspan class="path"> ~</tspan><tspan class="t"> $ </tspan><tspan class="cmd">cat about.json</tspan></text></g>

  <g class="l" style="animation-delay:.7s"><text x="28" y="96" class="br">{</text></g>

  <g class="l" style="animation-delay:1.0s"><text x="28" y="120"><tspan class="k">  "name":</tspan><tspan>      </tspan><tspan class="s">"Gurvinder Singh"</tspan><tspan class="br">,</tspan></text></g>

  <g class="l" style="animation-delay:1.3s"><text x="28" y="144"><tspan class="k">  "role":</tspan><tspan>      </tspan><tspan class="s">"Full-Stack Developer &amp; Automation Engineer"</tspan><tspan class="br">,</tspan></text></g>

  <g class="l" style="animation-delay:1.6s"><text x="28" y="168"><tspan class="k">  "studying":</tspan><tspan>  </tspan><tspan class="s">"Computer Science @ Lovely Professional University"</tspan><tspan class="br">,</tspan></text></g>

  <g class="l" style="animation-delay:1.9s"><text x="28" y="192"><tspan class="k">  "stack":</tspan><tspan>     </tspan><tspan class="br">[</tspan><tspan class="b">"React 19"</tspan><tspan class="br">, </tspan><tspan class="s">"Spring Boot"</tspan><tspan class="br">, </tspan><tspan class="a">"Python"</tspan><tspan class="br">, </tspan><tspan class="c">"Scapy"</tspan><tspan class="br">, </tspan><tspan class="d">"Linux"</tspan><tspan class="br">],</tspan></text></g>

  <g class="l" style="animation-delay:2.2s"><text x="28" y="216"><tspan class="k">  "focus":</tspan><tspan>     </tspan><tspan class="br">[</tspan><tspan class="b">"scalable backends"</tspan><tspan class="br">, </tspan><tspan class="c">"network security tooling"</tspan><tspan class="br">, </tspan><tspan class="d">"automation"</tspan><tspan class="br">],</tspan></text></g>

  <g class="l" style="animation-delay:2.5s"><text x="28" y="240"><tspan class="k">  "os":</tspan><tspan>        </tspan><tspan class="s">"Arch + Hyprland"</tspan><tspan class="br">,</tspan></text></g>

  <g class="l" style="animation-delay:2.8s"><text x="28" y="264"><tspan class="k">  "exploring":</tspan><tspan> </tspan><tspan class="br">[</tspan><tspan class="a">"Rust"</tspan><tspan class="br">, </tspan><tspan class="b">"Kubernetes"</tspan><tspan class="br">, </tspan><tspan class="d">"eBPF"</tspan><tspan class="br">, </tspan><tspan class="c">"LLM fine-tuning"</tspan><tspan class="br">],</tspan></text></g>

  <g class="l" style="animation-delay:3.1s"><text x="28" y="288"><tspan class="k">  "motto":</tspan><tspan>     </tspan><tspan fill="url(#motto)">"Breaking things. Fixing things. Shipping things."</tspan></text></g>

  <g class="l" style="animation-delay:3.4s"><text x="28" y="312" class="br">}</text></g>

  <g class="l" style="animation-delay:3.8s"><text x="28" y="344"><tspan class="user">apkx</tspan><tspan class="br">@</tspan><tspan class="host">arch</tspan><tspan class="path"> ~</tspan><tspan class="t"> $ </tspan><tspan class="cur" fill="#d4cebd">█</tspan></text></g>
</svg>
